# Copy to .env (gitignored) and fill in. Names only; never commit real values.
# src/config.ts loads .env at startup. An EMPTY value overrides the built-in default,
# so leave optional settings commented out unless you set them.

# Required for a live cycle (npx tsx src/desk.ts once|loop). Not needed for tests or the offline verifier.
GEMINI_API_KEY=

# Optional overrides (defaults are in src/config.ts and src/desk.ts)
# GEMINI_MODEL=
# RPC_URL=
# WS_URL=
# CLUSTER=
# POOL=
# PYTH_ACCOUNT=
# RECEIPTS_PROGRAM_ID=
# DESK_KEY_DIR=
# DATA_DIR=
# CYCLE_SECONDS=
# KOL_CHANNELS=
# DESK_SKIP_CRE=
# DESK_SKIP_KOL=
# DESK_AUTOPUBLISH=
# DESK_CMD=

# Chainlink CRE (these go in cre/.env, see cre/README.md)
# CRE_API_KEY=
# CRE_ETH_PRIVATE_KEY=
